# ==========================================
# SAT & Exam AI Solver Configuration
# ==========================================

# Select your provider: 'openrouter' (Omni-route) or 'anthropic' (Direct Cloud)
AI_PROVIDER=openrouter

# OpenRouter API Key (Supports Omni-route / all frontier models)
OPENROUTER_API_KEY=

# Anthropic Direct API Key (if using direct Anthropic Cloud)
ANTHROPIC_API_KEY=

# Vision extraction model (converts screenshot to Markdown question & describes visuals)
# Options:
#   OpenRouter: anthropic/claude-3.7-sonnet, anthropic/claude-3.5-sonnet, google/gemini-2.5-pro, openai/gpt-4o
#   Anthropic direct: claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022
VISION_MODEL=anthropic/claude-3.7-sonnet

# Frontier reasoning solver model (solves the MD questions step-by-step with deep proof)
# Options:
#   OpenRouter: anthropic/claude-3-opus, anthropic/claude-3.7-sonnet:thinking, openai/o3-mini
#   Anthropic direct: claude-3-opus-20240229, claude-3-7-sonnet-20250219
SOLVER_MODEL=anthropic/claude-3-opus

# Concurrency for batch processing 20-30 images in parallel (default 4)
MAX_CONCURRENCY=4

# Server settings
PORT=8000
HOST=0.0.0.0
